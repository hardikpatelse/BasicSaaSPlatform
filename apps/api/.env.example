# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# CORS Configuration
CORS_ORIGINS=http://localhost:4000,https://your-vercel-app.vercel.app

# Price IDs from Stripe (set these after creating products in Stripe)
STRIPE_STARTER_PRICE_ID=price_your_starter_plan_id
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id